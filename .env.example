# Copy these into Hostinger → your Web App → Environment variables.
# (Locally: copy to .env — never commit real values.)

# MongoDB Atlas connection string. Hostinger's MongoDB Atlas wizard sets MONGODB_URI automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rekha

# Long random string used to sign admin login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Admin login for /admin (created/updated on every start).
ADMIN_EMAIL=admin@rekhakrishnamurthy.com
ADMIN_PASSWORD=change-me

# Email alerts via Resend (enquiries, accept/reject emails, brochure emails).
RESEND_API_KEY=
SENDER_EMAIL=
ALERT_TO_EMAIL=

# Where uploaded images are stored. Must be OUTSIDE the deployed app folder so uploads
# survive redeploys. Default: ~/rekha-uploads
UPLOAD_DIR=

# Migration: copy uploaded images from the old site on first start (and on any missing image).
# Set to https://rekhakrishnamurthy.com while the old site is still live; clear it after go-live.
FILES_FALLBACK_ORIGIN=

# Used in SEO tags / sitemap.
SITE_URL=https://rekhakrishnamurthy.com

# Optional AI features (Face Studio try-on, voice enquiry). Leave empty to disable them.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Only for a brand-new empty database: insert the default pricing/services/blog content.
# Leave false when importing the exported data.
SEED_DEFAULTS=false
